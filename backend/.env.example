# BrandPulse AI - Backend Configuration
# Copy this file to .env and fill in your values

# ===================
# APP SETTINGS
# ===================
APP_NAME="BrandPulse AI"
APP_VERSION="1.0.0"
DEBUG=false

# ===================
# SECURITY
# ===================
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-min-32-characters-change-in-production

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ===================
# DATABASE
# ===================
# SQLite (default - good for development)
DATABASE_URL=sqlite+aiosqlite:///./brandpulse.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/brandpulse

# ===================
# AI - GROK (xAI) - PRIMARY AND ONLY LLM
# ===================
# Grok is the sole LLM used for all AI operations:
# - Content analysis and pattern extraction
# - Creative content generation
# - Engagement prediction explanations
# - Viral idea generation
#
# Get your API key at: https://console.x.ai/
GROK_API_KEY=xai-your-api-key-here
GROK_MODEL=grok-4-1-fast-reasoning

# ===================
# APIFY - SOCIAL MEDIA SCRAPING
# ===================
# Get your API key at: https://apify.com/
# Required for competitor analysis
APIFY_API_KEY=apify_api_your-key-here

# Apify Actor IDs (defaults work fine)
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_ACTOR=apify/tiktok-scraper
APIFY_LINKEDIN_ACTOR=apify/linkedin-posts-scraper

# ===================
# CACHE SETTINGS
# ===================
# How long to cache scraped data (in hours)
CACHE_TTL_HOURS=48

# ===================
# CONTENT SETTINGS
# ===================
MAX_POSTS_PER_COMPETITOR=30
MIN_ENGAGEMENT_THRESHOLD=100

# ===================
# OPTIONAL: FALLBACK APIS
# ===================
# PhantomBuster (alternative to Apify)
# PHANTOMBUSTER_API_KEY=
# USE_PHANTOMBUSTER_FALLBACK=false

# BuzzSumo (for trending topics)
# BUZZSUMO_API_KEY=
# USE_BUZZSUMO_FALLBACK=false
